# Copie para .env (uso local) ou configure como variáveis de ambiente no Vercel.

# Obrigatório em produção (Vercel): URL e token do seu banco Turso.
# Sem essas duas variáveis, o app usa um arquivo SQLite local em ./data (não funciona no Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Obrigatório em produção: uma string aleatória e secreta para assinar o login (JWT).
JWT_SECRET=

# Opcional: credenciais do admin criado automaticamente na primeira execução
# (só têm efeito quando o banco ainda não tem nenhum usuário).
ADMIN_EMAIL=admin@kawash.com
ADMIN_PASSWORD=admin123

# Opcional, só para rodar localmente fora da porta padrão 3000.
PORT=3000
